# ─────────────────────────────────────────────────────────
#  OPEN INTEL — Environment Variables
#  Copy this file to .env and fill in your values
#  NEVER commit .env to GitHub
# ─────────────────────────────────────────────────────────

# Groq API Key (Required for AI Threat Analysis)
# Get your free key at: https://console.groq.com
# Free tier: 14,400 requests/day — more than enough
GROQ_API_KEY=your_groq_api_key_here

# ─── Optional: AlienVault OTX (Threat Intel) ──────────────
# Free account at: https://otx.alienvault.com
# Increases threat intel accuracy significantly
OTX_API_KEY=your_otx_api_key_here

# ─── Optional: Shodan (IP Intelligence) ───────────────────
# Free account at: https://shodan.io
# Needed for advanced IP scanning features
SHODAN_API_KEY=your_shodan_api_key_here
